          "text": "the"
        },
        {
          "end_frame": 419,
          "index": 32,
          "start_frame": 411,
          "text": "thing..."
        }
      ]
    },
    {
      "end_frame": 489,
      "id": "caption-009",
      "start_frame": 419,
      "text": "or escaping the countdown?",
      "words": [
        {
          "end_frame": 444,
          "index": 33,
