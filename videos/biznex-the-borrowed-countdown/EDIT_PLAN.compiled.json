        {
          "end_frame": 198,
          "index": 16,
          "start_frame": 190,
          "text": "I"
        },
        {
          "end_frame": 207,
          "index": 17,
          "start_frame": 197,
          "text": "hadn't"
        },
        {
          "end_frame": 214,
          "index": 18,
          "start_frame": 207,
          "text": "wanted"
        },
        {
          "end_frame": 219,
          "index": 19,
          "start_frame": 214,
          "text": "a"
        }
      ]
    },
    {
      "end_frame": 246,
      "id": "caption-005",
      "start_frame": 219,
      "text": "minute ago.",
