      "end_frame": 48,
      "id": "caption-001",
      "start_frame": 0,
      "text": "The timer was loud.",
      "words": [
        {
          "end_frame": 8,
          "index": 0,
          "start_frame": 0,
          "text": "The"
        },
        {
          "end_frame": 18,
          "index": 1,
          "start_frame": 8,
          "text": "timer"
        },
        {
          "end_frame": 26,
          "index": 2,
          "start_frame": 17,
          "text": "was"
        },
        {
          "end_frame": 39,
          "index": 3,
          "start_frame": 25,
          "text": "loud."
        }
      ]
    },
    {
      "end_frame": 96,
      "id": "caption-002",
      "start_frame": 54,
      "text": "My reason was missing.",
      "words": [
        {
          "end_frame": 59,
          "index": 4,
          "start_frame": 54,
          "text": "My"
        },
        {
          "end_frame": 69,
