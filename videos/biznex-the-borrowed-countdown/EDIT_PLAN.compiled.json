          "text": "stopped."
        }
      ]
    },
    {
      "end_frame": 419,
      "id": "caption-008",
      "start_frame": 382,
      "text": "Was I choosing the thing...",
      "words": [
        {
          "end_frame": 387,
          "index": 28,
          "start_frame": 382,
          "text": "Was"
        },
        {
          "end_frame": 392,
