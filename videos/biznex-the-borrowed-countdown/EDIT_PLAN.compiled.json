        }
      ]
    },
    {
      "end_frame": 360,
      "id": "caption-007",
      "start_frame": 311,
      "text": "Then I stopped.",
      "words": [
        {
          "end_frame": 324,
          "index": 25,
          "start_frame": 311,
          "text": "Then"
        },
        {
          "end_frame": 337,
          "index": 26,
