    {
      "index": 0,
      "id": "beat-01",
      "text": "The timer was loud. My reason was missing.",
      "start": 0.0,
      "end": 3.41,
      "delivery": "Speak intimately to a friend, troubled by the realization but not melodramatic. Let the contrast between loud and missing land clearly.",
      "pause_after_ms": 250
    },
    {
      "index": 1,
      "id": "beat-02",
      "text": "Ten seconds left, and suddenly I wanted something I hadn't wanted a minute ago.",
      "start": 3.41,
      "end": 8.47,
      "delivery": "Speak with growing urgency and rueful surprise at yourself, as one connected thought. Keep every word clear as the pressure builds.",
      "pause_after_ms": 180
    },
    {
      "index": 2,
      "id": "beat-03",
      "text": "My hand moved. Then I stopped.",
      "start": 8.47,
      "end": 12.73,
      "delivery": "Speak slowly and clearly, with quiet determination, as two complete thoughts. Give My hand a clear beginning, then let stopped settle. Do not whisper.",
      "pause_after_ms": 700
    },
    {
      "index": 3,
      "id": "beat-04",
      "text": "Was I choosing the thing... or escaping the countdown?",
      "start": 12.73,
      "end": 16.78,
      "delivery": "Ask yourself with genuine uncertainty and curiosity, intimate and thoughtful. Gently stress the contrast between choosing and escaping.",
      "pause_after_ms": 450
    },
    {
      "index": 4,
      "id": "beat-05",
      "text": "I let the numbers keep falling. The clock could finish its countdown. I still needed a reason.",
      "start": 16.78,
      "end": 23.9,
      "delivery": "Speak with grounded relief and quiet confidence, warm rather than triumphant. Leave room for the final realization: I still needed a reason.",
