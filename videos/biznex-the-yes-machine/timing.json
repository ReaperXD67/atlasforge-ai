    {
      "index": 0,
      "id": "beat-01",
      "text": "My most expensive habit? Saying yes… before I'd even thought about it.",
      "start": 0.0,
      "end": 7.06,
      "delivery": "Speak candidly to a friend, amused at your own mistake, with a rueful smile.",
      "pause_after_ms": 220
    },
    {
      "index": 1,
      "id": "beat-02",
      "text": "One little yes. Then the money. The time. The stuff I didn't need.",
      "start": 7.06,
      "end": 12.32,
      "delivery": "Speak with rueful frustration. Let each short thought build on the last, quicker and a little more exasperated.",
      "pause_after_ms": 300
    },
    {
      "index": 2,
      "id": "beat-03",
      "text": "So I tried something awkward. I paused.",
      "start": 12.32,
      "end": 17.16,
      "delivery": "soft",
      "pause_after_ms": 800
    },
    {
      "index": 3,
      "id": "beat-04",
      "text": "What does it cost? Will I use it? Does it fit my life?",
      "start": 17.16,
      "end": 21.63,
      "delivery": "Ask these questions with genuine curiosity, clear and conversational, as if working something out.",
      "pause_after_ms": 350
    },
    {
      "index": 4,
      "id": "beat-05",
      "text": "Turns out… a good choice can wait for you.",
      "start": 21.63,
      "end": 26.27,
      "delivery": "Speak with real relief and a warm small smile, quietly pleased by the realization.",
      "pause_after_ms": 0
    }
  ],
