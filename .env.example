# Copy this file to .env. Leave optional providers blank.

# Text generation (pick at least one; OpenRouter is the low-cost default)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional premium video providers. Disabled by default in config/default.yaml.
MINIMAX_API_KEY=

# Optional stock-photo source. Free developer key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional local providers
COMFYUI_BASE_URL=http://127.0.0.1:8188
PIPER_EXECUTABLE=
PIPER_MODEL_PATH=
KOKORO_MODEL_PATH=

# YouTube uses an OAuth client-secret JSON file, not a client secret pasted here.
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Runtime
OUTPUT_DIRECTORY=output
CONFIG_FILE=config/default.yaml
LOG_LEVEL=INFO
TZ=Asia/Kolkata

