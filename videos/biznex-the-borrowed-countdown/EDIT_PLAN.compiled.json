          "text": "seconds"
        },
        {
          "end_frame": 142,
          "index": 10,
          "start_frame": 132,
          "text": "left,"
        },
        {
          "end_frame": 157,
          "index": 11,
          "start_frame": 142,
          "text": "and"
        },
        {
          "end_frame": 168,
          "index": 12,
          "start_frame": 157,
          "text": "suddenly"
        },
        {
          "end_frame": 173,
          "index": 13,
          "start_frame": 167,
          "text": "I"
        }
      ]
    },
    {
      "end_frame": 219,
      "id": "caption-004",
      "start_frame": 173,
      "text": "wanted something I hadn't wanted a",
      "words": [
        {
          "end_frame": 180,
          "index": 14,
