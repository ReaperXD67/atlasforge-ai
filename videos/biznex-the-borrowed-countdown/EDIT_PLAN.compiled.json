          "start_frame": 59,
          "text": "reason"
        },
        {
          "end_frame": 78,
          "index": 6,
          "start_frame": 69,
          "text": "was"
        },
        {
          "end_frame": 87,
          "index": 7,
          "start_frame": 77,
          "text": "missing."
        }
      ]
    },
    {
      "end_frame": 173,
      "id": "caption-003",
      "start_frame": 102,
      "text": "Ten seconds left, and suddenly I",
      "words": [
        {
          "end_frame": 120,
          "index": 8,
          "start_frame": 102,
          "text": "Ten"
